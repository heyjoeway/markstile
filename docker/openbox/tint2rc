# MarkStile console taskbar: one button per browser window, no launchers or tray.
panel_items = T
panel_position = bottom center horizontal
panel_size = 100% 34
panel_background_id = 1
panel_padding = 4 3 4
panel_dock = 0
strut_policy = follow_size
wm_menu = 1
taskbar_mode = single_desktop
taskbar_background_id = 0
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 320 30
task_padding = 8 4 6
task_font = Noto Sans 10
task_font_color = #e6e6e6 100
task_active_font_color = #ffffff 100
task_background_id = 2
task_active_background_id = 3
mouse_left = toggle_iconify
backend = auto

# 1: panel
rounded = 0
border_width = 0
background_color = #212121 100
border_color = #000000 0

# 2: task
rounded = 4
border_width = 0
background_color = #333333 100
border_color = #000000 0

# 3: active task
rounded = 4
border_width = 0
background_color = #7c3636 100
border_color = #000000 0
